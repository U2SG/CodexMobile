# Local-only sample. Replace with your own environment; never commit .env.
HOST=127.0.0.1
PORT=3321
CODEXMOBILE_AGENT=codex

# Empty/unset pairing code generates a fresh random code at startup.
# CODEXMOBILE_PAIRING_CODE=
# CODEXMOBILE_PUBLIC_URL=https://agent-host.example
# CODEXMOBILE_HOME=./.codexmobile/state
# CODEX_HOME=
# CLAUDE_HOME=
# CODEXMOBILE_PEER_URLS=Claude|claude|https://claude.example,Codex|codex|https://codex.example

# Keep optional runners opt-in until their acceptance checks pass.
# CODEXMOBILE_CODEX_USE_APP_SERVER=1
# CODEXMOBILE_USE_IPC_TURNS=1
# CODEXMOBILE_CLAUDE_MODEL=sonnet
# CODEXMOBILE_CLAUDE_EFFORT=high

# Optional integrations: keep credentials only in your local environment.
# OPENAI_API_KEY=
# CLIPROXYAPI_API_KEY=
# CODEXMOBILE_CLIPROXY_MANAGEMENT_URL=
# CODEXMOBILE_CLIPROXY_MANAGEMENT_KEY=
# CODEXMOBILE_FEISHU_APP_ID=
# CODEXMOBILE_FEISHU_APP_SECRET=
# CODEXMOBILE_TRANSCRIBE_API_KEY=
# CODEXMOBILE_REALTIME_API_KEY=
# CODEXMOBILE_IMAGE_API_KEY=
# CODEXMOBILE_PUSH_SUBJECT=
